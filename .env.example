# ========================================================
# BAHI HATA - PRODUCTION ENVIRONMENT CONFIGURATION
# Subdomain: bahi-hata.theabhilasha.in
# Stack: Supabase PostgreSQL (Free) + Vercel Serverless (Free)
# Storage: Supabase Storage (Free 1GB + Smart Edge CDN)
# ========================================================

# --- Django Core ---
DJANGO_DEBUG=False
SECRET_KEY=generate_a_random_50_character_secret_key_here

# --- Database Configuration (Supabase PostgreSQL Free Tier) ---
# Supabase Dashboard > Project Settings > Database > Connection String > URI
# Switch to 'Connection Pooling' (Supavisor) - Mode: Transaction (port 6543) or Session (port 5432)
# Example: postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DB_SSL_REQUIRE=True

# --- Supabase Auth & Storage Configuration ---
# Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
# Optional: Service Role Secret (allows automatic bucket management / admin uploads)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret
# Storage bucket name for book, magazine, and combo images (Free Tier)
SUPABASE_STORAGE_BUCKET=bahi-hata-images

# --- Google OAuth (GIS Client ID for Direct Google Login) ---
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# --- Security & Allowed Domains (Comma-separated) ---
# Subdomain and root domain for production
ALLOWED_HOSTS=bahi-hata.theabhilasha.in,.theabhilasha.in,.vercel.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://bahi-hata.theabhilasha.in,https://*.theabhilasha.in,https://*.vercel.app,http://localhost:8000

# --- Payment Gateway (Razorpay) ---
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_CURRENCY=INR
